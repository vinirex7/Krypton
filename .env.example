# .env.example — Template de variáveis de ambiente
# Copie este arquivo para .env e preencha com suas chaves reais:
#   cp .env.example .env
#
# ⚠️ NUNCA commitar o arquivo .env real no repositório.

BINANCE_API_KEY=sua_chave_api_aqui
BINANCE_API_SECRET=seu_secret_aqui

# Estratégia live promovida.
LIVE_STRATEGY=AGGRESSIVE_C

# Segurança: o código usa TESTNET por padrão. Para capital real, altere de forma
# consciente para false somente no VPS de produção.
USE_TESTNET=true

# Banco separado do modo legado; não reutilize krypton_state.db.
AGGRESSIVE_C_STATE_DB_FILE=krypton_c_state.db

# Em primeira inicialização a C exige conta/subconta limpa por padrão para não
# confundir saldos antigos com quantidades dos sleeves tático/alpha.
AGGRESSIVE_C_REQUIRE_CLEAN_START=true

# Permissões necessárias na API Binance:
#   ✅ Enable Reading
#   ✅ Enable Spot & Margin Trading
#   ❌ NUNCA habilitar Enable Withdrawals
#   ❌ NUNCA habilitar Enable Futures (Aggressive C é Spot 1x)
#
# Segurança adicional:
#   - Restringir a API ao IP fixo do VPS
#   - Ativar 2FA na conta Binance
